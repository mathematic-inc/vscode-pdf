amends ".hk/org.pkl"

// assets/pdf.js is the vendored PDF.js build, and patches/pdf.js.patch is a diff of it.
exclude = super.exclude + List("assets/pdf.js/**", "patches/*.patch")

steps {
  // JSON with comments.
  ["jq"] { exclude = super.exclude + List("**/tsconfig*.json", ".vscode/*.json") }
  ["typescript"] {
    glob = List("package.json", "tsconfig*.json", "src/**/*.ts", "tsup.config.ts")
    check = "pnpm run typecheck"
    depends = "oxlint"
  }
  ["pdfjs"] {
    glob =
      List(
        "assets/main.css",
        "assets/main.mjs",
        "assets/pdf.js/**",
        "package.json",
        "patches/pdf.js.patch",
        "src/pdf-viewer-provider.ts",
        "tools/check_pdfjs.mjs",
      )
    check = "pnpm run check:pdfjs"
    depends = "typescript"
  }
}
