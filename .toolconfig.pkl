amends
  "package://github.com/mathematic-inc/toolconfig/releases/download/v2026.11.6/toolconfig@2026.11.6#/ToolConfig.pkl"

root = true

toolconfig {
  `extends` =
    List(new Repository {
      git = "https://github.com/mathematic-inc/toolconfig-config.git"
      rev = "fc76ddad46c14a7b7fe03bf117a92ede11ea0dfb"
      path = "profiles/org/.toolconfig.pkl"
    })
}

sections {
  ["*"] {
    // assets/pdf.js is the vendored PDF.js build.
    oxfmt {
      ignorePatterns =
        List(
          "**/dist/**",
          "**/gen/**",
          "**/generated/**",
          "**/node_modules/**",
          "**/target/**",
          "**/vendor/**",
          "**/*.md",
          "**/*.toml",
          "assets/pdf.js/**",
        )
    }
    oxlint {
      ignorePatterns =
        List(
          "**/dist/**",
          "**/gen/**",
          "**/generated/**",
          "**/node_modules/**",
          "**/target/**",
          "**/vendor/**",
          "assets/pdf.js/**",
        )
      rules {
        ["typescript/prefer-readonly-parameter-types"] =
          List("deny", new Mapping {
            ["allow"] =
              List(
                // The rule does not see the classes of the VS Code API as readonly. They have
                // methods and members that the extension host writes.
                new Mapping {
                  ["from"] = "package"
                  ["package"] = "vscode"
                  ["name"] =
                    List("Disposable", "ExtensionContext", "Uri", "Webview", "WebviewPanel")
                },
                // The rule does not see the DOM events that the webview gives to a listener as
                // readonly. The browser makes these objects.
                new Mapping {
                  ["from"] = "lib"
                  ["name"] = List("ErrorEvent", "KeyboardEvent", "MessageEvent")
                },
              )
          })
      }
    }
    typos {
      ["default"] { ["extend-identifiers"] { ["ba13d00"] = "ba13d00" } }
      files {
        ["extend-exclude"] =
          List(
            "**/dist/**",
            "**/gen/**",
            "**/generated/**",
            "**/node_modules/**",
            "**/target/**",
            "**/vendor/**",
            "CHANGELOG.md",
            "assets/pdf.js/**",
          )
      }
    }
  }
}
