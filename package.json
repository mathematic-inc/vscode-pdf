{
  "name": "vscode-pdf",
  "displayName": "PDF Viewer",
  "version": "0.2.7",
  "description": "Portable document format (PDF) viewer for Visual Studio Code.",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "reader",
    "document",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathematic-inc/vscode-pdf.git"
  },
  "license": "Apache-2.0",
  "author": "Mathematic Inc",
  "publisher": "mathematic",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsup",
    "check": "pnpm run typecheck && pnpm run check:pdfjs && oxlint --deny-warnings . && oxfmt --check .",
    "check:pdfjs": "node tools/check_pdfjs.mjs",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "package": "pnpm run check:pdfjs && tsup --minify",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run package",
    "watch": "tsup --watch"
  },
  "contributes": {
    "configuration": {
      "title": "PDF",
      "type": "object",
      "properties": {
        "pdf.defaultZoomValue": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "page-actual",
            "page-fit",
            "page-width",
            "50",
            "75",
            "100",
            "125",
            "150",
            "200"
          ],
          "enumDescriptions": [
            "Automatic",
            "Actual size",
            "Fit page",
            "Fit width",
            "50%",
            "75%",
            "100%",
            "125%",
            "150%",
            "200%"
          ],
          "description": "Default zoom level when opening a PDF."
        },
        "pdf.sidebarViewOnLoad": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "enum": [
            -1,
            0,
            1,
            2,
            3,
            4
          ],
          "enumDescriptions": [
            "Restore previous state",
            "None",
            "Thumbnails",
            "Outline",
            "Attachments",
            "Layers"
          ],
          "description": "Sidebar panel to show when opening a PDF."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "pdf.view",
        "displayName": "PDF View",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.145.0",
    "@vscode/vsce": "^4.1.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "vscode": "^1.145.0"
  },
  "icon": "icon.png"
}
